# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Leave empty on same-origin web deployments (Vercel / Node).
# For Android APK builds (Capacitor), set to your public HTTPS backend URL, e.g.:
# VITE_API_BASE_URL="https://tu-proyecto.vercel.app"
VITE_API_BASE_URL=""

# SESSION_SECRET: Secret key used to sign session tokens in production.
SESSION_SECRET="CHANGE_TO_RANDOM_64_CHAR_HEX_IN_PRODUCTION"

# KV_REST_API_URL / KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN):
# Optional on local Node server (uses ./data/db.json).
# Recommended on Vercel Serverless for persistent database storage across cold starts.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ALLOWED_ORIGINS: Comma-separated origins allowed for CORS (optional).
ALLOWED_ORIGINS=""
